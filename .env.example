# ==============================================================================
# FintechDemo - Shared Environment Configuration
# Copy to `.env` at the project root for local development.
# Never commit `.env` with real secrets.
# ==============================================================================

# --- Application ---
APP_NAME=FintechDemo
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL + pgvector (Local Docker Compose) ---
POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech_dev_password
POSTGRES_DB=fintech_demo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fintech:fintech_dev_password@localhost:5432/fintech_demo

# --- Google Gemini (Backend Only) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Frontend (Vite public vars - MUST use VITE_ prefix; NEVER put secrets here) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
